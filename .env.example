# Copy to .env (never commit .env). All values are optional in DEMO_MODE.

# --- Mode -------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod
DEMO_MODE=false                  # true = scripted bots + template commentary, no API keys needed

# --- Players (open-weight models) --------------------------------------
INFERENCE_BACKEND=hf             # hf | bedrock | ollama | fake
HF_TOKEN=                        # https://huggingface.co/settings/tokens (Inference Providers permission)
MISTRAL_API_KEY=                 # https://console.mistral.ai (free tier): Mistral seat in dev (HF hosts no Mistral chat model)
OLLAMA_BASE_URL=http://localhost:11434/v1
AWS_REGION=us-west-2             # Bedrock region with all roster models + the DeepSeek judge

# --- Analyst: commentator, emotion tagger, lie detector, judge ---------
ANALYST_BACKEND=none             # none (templates) | bedrock (DeepSeek-V3.1 judge, prod) | openai_compat
ANALYST_API_KEY=                 # for openai_compat, e.g. a free Google AI Studio key (Gemini 2.5 Flash)
ANALYST_MODEL=                   # optional override of the models.yaml analyst

# --- Storage -----------------------------------------------------------
STORAGE_BACKEND=sqlite           # sqlite | dynamodb | memory
DYNAMODB_TABLE=outsmart-games

# --- Access control & spend guards --------------------------------------
ADMIN_PASSCODE=change-me         # required to START games (watching/replays are public)
MAX_GAMES_PER_DAY=20
MAX_CONCURRENT_GAMES=2
START_RATE_LIMIT=5/hour

# --- Pacing ------------------------------------------------------------
EVENT_PACING_MS=600              # delay between streamed events so humans can follow
