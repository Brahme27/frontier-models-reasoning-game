# Copy to backend.hcl (git-ignored) using the values printed by the bootstrap stack:
#   terraform -chdir=../../bootstrap output -raw backend_config > backend.hcl
bucket       = "outsmart-tfstate-<ACCOUNT_ID>-us-west-2"
key          = "outsmart/prod/terraform.tfstate"
region       = "us-west-2"
use_lockfile = true
encrypt      = true
